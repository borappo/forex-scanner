//@version=6
indicator("Forex Majors Scanner — Trend / Gegentrend", overlay = true, max_bars_back = 200)

// ════════════════════════════════════════════════
//  EINSTELLUNGEN
// ════════════════════════════════════════════════

// --- MACD ---
macdFast    = input.int(12, "MACD schnell", minval = 1, group = "MACD")
macdSlow    = input.int(26, "MACD langsam", minval = 1, group = "MACD")
macdSigLen  = input.int(9,  "MACD Signal",  minval = 1, group = "MACD")
macdSigType = input.string("SMA", "MACD Signaltyp", options = ["SMA", "EMA"], group = "MACD")

// --- Bollinger Bänder ---
bbLength = input.int(12,   "BB Länge",  minval = 1,   group = "Bollinger Bänder")
bbMult   = input.float(2.0,"BB StdDev", minval = 0.1, step = 0.1, group = "Bollinger Bänder")

// --- Filter Kriterien TREND & GEGENTREND (Soft-Filter, einzeln deaktivierbar) ---
gFilter         = "Filter Kriterien TREND & GEGENTREND"
useCloseFilter  = input.bool(true, "", inline = "close",  group = gFilter)
minPipsClose    = input.int(6,  "Min. Abstand Close ↔ Außenband (Pips)",   minval = 0, inline = "close",  group = gFilter)
useSpreadFilter = input.bool(true, "", inline = "spread", group = gFilter)
minPipsSpread   = input.int(20, "Min. Abstand Mittel- ↔ Außenband (Pips)", minval = 0, inline = "spread", group = gFilter)
useMaxBarsFilter = input.bool(true, "", inline = "maxbars", group = gFilter)
maxTrendBars     = input.int(6, "Max. farbige Kerzen für TREND-Signal", minval = 1, inline = "maxbars", group = gFilter)

// --- Darstellung ---
// Sichtbarkeit von Bändern und Breakout-Markierungen wird direkt im Style-Tab
// gesteuert (jeder Plot hat einen eigenen Eintrag) — daher keine Inputs mehr.
tblOffset  = input.int(3, "Tabellen-Versatz nach links (% Chartbreite)", minval = 0, maxval = 50, group = "Darstellung")

// --- Symbole (Checkbox = aktiv, leeres Feld = ebenfalls deaktiviert) ---
gSym = "Symbole  (Checkbox aktiviert das Paar — nur Paar ohne Broker, z.B. EURUSD)"
broker = input.string("SWISSQUOTE", "Broker / Datenquelle",
     options = ["SWISSQUOTE", "SAXO", "IBKR", "OANDA", "FX", "FXCM"],
     group = gSym)
e01 = input.bool(true, "", inline = "01", group = gSym)
p01 = input.string("EURUSD", "Paar 01", inline = "01", group = gSym)
e02 = input.bool(true, "", inline = "02", group = gSym)
p02 = input.string("GBPUSD", "Paar 02", inline = "02", group = gSym)
e03 = input.bool(true, "", inline = "03", group = gSym)
p03 = input.string("USDJPY", "Paar 03", inline = "03", group = gSym)
e04 = input.bool(true, "", inline = "04", group = gSym)
p04 = input.string("USDCHF", "Paar 04", inline = "04", group = gSym)
e05 = input.bool(true, "", inline = "05", group = gSym)
p05 = input.string("USDCAD", "Paar 05", inline = "05", group = gSym)
e06 = input.bool(true, "", inline = "06", group = gSym)
p06 = input.string("AUDUSD", "Paar 06", inline = "06", group = gSym)
e07 = input.bool(true, "", inline = "07", group = gSym)
p07 = input.string("NZDUSD", "Paar 07", inline = "07", group = gSym)
e08 = input.bool(true, "", inline = "08", group = gSym)
p08 = input.string("EURGBP", "Paar 08", inline = "08", group = gSym)
e09 = input.bool(true, "", inline = "09", group = gSym)
p09 = input.string("EURJPY", "Paar 09", inline = "09", group = gSym)
e10 = input.bool(true, "", inline = "10", group = gSym)
p10 = input.string("EURCHF", "Paar 10", inline = "10", group = gSym)
e11 = input.bool(true, "", inline = "11", group = gSym)
p11 = input.string("EURCAD", "Paar 11", inline = "11", group = gSym)
e12 = input.bool(true, "", inline = "12", group = gSym)
p12 = input.string("EURAUD", "Paar 12", inline = "12", group = gSym)
e13 = input.bool(true, "", inline = "13", group = gSym)
p13 = input.string("EURNZD", "Paar 13", inline = "13", group = gSym)
e14 = input.bool(true, "", inline = "14", group = gSym)
p14 = input.string("GBPJPY", "Paar 14", inline = "14", group = gSym)
e15 = input.bool(true, "", inline = "15", group = gSym)
p15 = input.string("GBPCHF", "Paar 15", inline = "15", group = gSym)
e16 = input.bool(true, "", inline = "16", group = gSym)
p16 = input.string("GBPCAD", "Paar 16", inline = "16", group = gSym)
e17 = input.bool(true, "", inline = "17", group = gSym)
p17 = input.string("GBPAUD", "Paar 17", inline = "17", group = gSym)
e18 = input.bool(true, "", inline = "18", group = gSym)
p18 = input.string("GBPNZD", "Paar 18", inline = "18", group = gSym)
e19 = input.bool(true, "", inline = "19", group = gSym)
p19 = input.string("CHFJPY", "Paar 19", inline = "19", group = gSym)
e20 = input.bool(true, "", inline = "20", group = gSym)
p20 = input.string("CADJPY", "Paar 20", inline = "20", group = gSym)
e21 = input.bool(true, "", inline = "21", group = gSym)
p21 = input.string("AUDJPY", "Paar 21", inline = "21", group = gSym)
e22 = input.bool(true, "", inline = "22", group = gSym)
p22 = input.string("NZDJPY", "Paar 22", inline = "22", group = gSym)
e23 = input.bool(true, "", inline = "23", group = gSym)
p23 = input.string("CADCHF", "Paar 23", inline = "23", group = gSym)
e24 = input.bool(true, "", inline = "24", group = gSym)
p24 = input.string("AUDCHF", "Paar 24", inline = "24", group = gSym)
e25 = input.bool(true, "", inline = "25", group = gSym)
p25 = input.string("NZDCHF", "Paar 25", inline = "25", group = gSym)
e26 = input.bool(true, "", inline = "26", group = gSym)
p26 = input.string("AUDCAD", "Paar 26", inline = "26", group = gSym)
e27 = input.bool(true, "", inline = "27", group = gSym)
p27 = input.string("NZDCAD", "Paar 27", inline = "27", group = gSym)
e28 = input.bool(true, "", inline = "28", group = gSym)
p28 = input.string("AUDNZD", "Paar 28", inline = "28", group = gSym)

// ════════════════════════════════════════════════
//  INDIKATOR-HELPER  (kontextneutral: laufen im aufrufenden Symbol/TF)
// ════════════════════════════════════════════════
f_macd() =>
    macdLine   = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
    signalLine = macdSigType == "EMA" ? ta.ema(macdLine, macdSigLen) : ta.sma(macdLine, macdSigLen)
    [macdLine, signalLine]

f_bb() =>
    basis = ta.sma(close, bbLength)
    dev   = bbMult * ta.stdev(close, bbLength)
    [basis + dev, basis, basis - dev]

// ════════════════════════════════════════════════
//  BERECHNUNG  (läuft im Kontext des jeweiligen Symbols)
//  Gibt für die LETZTE ABGESCHLOSSENE Kerze zurück: [gegentrend, trend]
// ════════════════════════════════════════════════
f_scan() =>
    [macdLine, signalLine] = f_macd()
    [upper, basis, lower] = f_bb()

    // Hintergrund-Klassifikation pro Kerze
    isGreen   = macdLine > 0 and macdLine > signalLine
    isRed     = macdLine < 0 and macdLine < signalLine
    isColored = isGreen or isRed
    isNeutral = not isColored

    // Länge der aktuellen gleichfarbigen Kerzen-Serie (0 bei neutral).
    // Direkter Farbwechsel grün ↔ rot startet eine neue Serie bei 1.
    var int coloredRun = 0
    coloredRun := isGreen ? (isGreen[1] ? coloredRun[1] + 1 : 1) :
         isRed ? (isRed[1] ? coloredRun[1] + 1 : 1) : 0

    // Schlusskurs ausserhalb der Bollinger Bänder?
    outside = close > upper or close < lower

    // Dynamischer Offset, um IMMER auf die letzte ABGESCHLOSSENE Kerze
    // zu schauen — unabhängig davon, ob der Markt gerade offen ist:
    //   - Markt offen (aktuelle Bar formt sich noch): off = 1 → vorherige Bar
    //   - Markt zu  (aktuelle Bar ist bereits final, z.B. Wochenende): off = 0 → aktuelle Bar
    int off = time_close <= timenow ? 0 : 1

    // Soft-Filter: greifen nur, wenn ihre Checkbox aktiv ist.
    // JPY-Paare quotieren 2-stellig (1 Pip = 0.01), alle anderen 4-stellig (1 Pip = 0.0001).
    pipSize = str.endswith(syminfo.ticker, "JPY") ? 0.01 : 0.0001

    // Filter A: Bandbreite Mittel- ↔ Außenband
    spreadOk = not useSpreadFilter or (upper[off] - basis[off]) >= minPipsSpread * pipSize

    // Filter B: Abstand Close ↔ Außenband
    //   GEGENTREND (close außerhalb): wie weit hat close das Band überschossen?
    //   TREND      (close innerhalb): wie weit ist close vom nächsten Außenband entfernt?
    distClose = outside[off]
         ? (close[off] > upper[off] ? close[off] - upper[off] : lower[off] - close[off])
         : math.min(upper[off] - close[off], close[off] - lower[off])
    closeOk = not useCloseFilter or distClose >= minPipsClose * pipSize

    // Filter C (nur TREND): Signal nur bis zur N-ten farbigen Kerze der Serie —
    // danach gilt der Einstieg als verpasst.
    freshOk = not useMaxBarsFilter or coloredRun[off] <= maxTrendBars

    // Gegentrend-Kerze: neutral, ODER erste farbige Kerze nach einer Neutral-Phase
    gegentrendCandle = isNeutral[off] or (isColored[off] and isNeutral[off + 1])
    trendCandle      = isColored[off]

    gegentrend = outside[off]       and gegentrendCandle and spreadOk and closeOk
    trend      = (not outside[off]) and trendCandle      and spreadOk and closeOk and freshOk

    [gegentrend, trend]

// ════════════════════════════════════════════════
//  SCAN ALLER SLOTS
// ════════════════════════════════════════════════
var string[] gegenList = array.new_string()
var string[] trendList = array.new_string()
array.clear(gegenList)
array.clear(trendList)

handle(simple bool enabled, simple string pair) =>
    valid = enabled and str.length(pair) > 0
    sym   = valid ? broker + ":" + pair : broker + ":EURUSD"   // Dummy für deaktivierte Slots
    [g, t] = request.security(sym, timeframe.period, f_scan())
    if valid and barstate.islast
        if g
            array.push(gegenList, pair)
        if t
            array.push(trendList, pair)

handle(e01, p01)
handle(e02, p02)
handle(e03, p03)
handle(e04, p04)
handle(e05, p05)
handle(e06, p06)
handle(e07, p07)
handle(e08, p08)
handle(e09, p09)
handle(e10, p10)
handle(e11, p11)
handle(e12, p12)
handle(e13, p13)
handle(e14, p14)
handle(e15, p15)
handle(e16, p16)
handle(e17, p17)
handle(e18, p18)
handle(e19, p19)
handle(e20, p20)
handle(e21, p21)
handle(e22, p22)
handle(e23, p23)
handle(e24, p24)
handle(e25, p25)
handle(e26, p26)
handle(e27, p27)
handle(e28, p28)

// ════════════════════════════════════════════════
//  BOLLINGER BÄNDER  (aktuelles Chart-Symbol)
// ════════════════════════════════════════════════
[bbUpper, bbBasis, bbLower] = f_bb()

// Bänder nur bis zur letzten abgeschlossenen Kerze zeichnen — die aktuell
// formende Bar bekommt na, damit der Plot dort endet.
barClosed = time_close <= timenow
bbColor = color.new(#B2B5BE, 0)
pUpper = plot(barClosed ? bbUpper : na, "BB Oben",  color = bbColor)
plot(barClosed ? bbBasis : na, "BB Basis", color = bbColor)
pLower = plot(barClosed ? bbLower : na, "BB Unten", color = bbColor)
// Default ausgeblendet (display.none) — bleibt aber im Style-Tab aktivierbar.
fill(pUpper, pLower, color = color.new(#B2B5BE, 92), title = "BB Fläche", display = display.none)

// ════════════════════════════════════════════════
//  MARKIERUNGEN  —  Schlusskurs außerhalb der Bänder
//  plotshape mit style.arrowup/arrowdown: getrennte, benannte Einträge im
//  Style-Tab („Breakout Oben" / „Breakout Unten"), einzeln toggelbar.
//  barIsFinal gated die noch offene Session-Bar aus — kein Flackern auf
//  Live-Ticks, und die Wochenend-/Feiertags-Bar wird automatisch markiert.
// ════════════════════════════════════════════════
barIsFinal = time_close <= timenow
plotshape(barIsFinal and close > bbUpper, title = "Breakout Oben",
     style = shape.arrowup, location = location.abovebar, color = color.green, size = size.small)
plotshape(barIsFinal and close < bbLower, title = "Breakout Unten",
     style = shape.arrowdown, location = location.belowbar, color = color.red, size = size.small)

// ════════════════════════════════════════════════
//  CHART-HINTERGRUND  (aktuelles Chart-Symbol)
//  Gleiches off-Pattern wie in f_scan(): färbt immer anhand der letzten
//  ABGESCHLOSSENEN Kerze, damit die live Bar nicht bei jedem Tick flippt
//  und die Färbung mit der Scanner-Klassifikation übereinstimmt.
// ════════════════════════════════════════════════
[cMacd, cSig] = f_macd()
int cOff = time_close <= timenow ? 0 : 1
chartGreen = cMacd[cOff] > 0 and cMacd[cOff] > cSig[cOff]
chartRed   = cMacd[cOff] < 0 and cMacd[cOff] < cSig[cOff]
bgcolor(chartGreen ? color.new(color.green, 88) : chartRed ? color.new(color.red, 88) : na, title = "Hintergrund Trendrichtung")

// ════════════════════════════════════════════════
//  TABELLE
// ════════════════════════════════════════════════
// Voll transparenter Zellrand: hält 1px Abstand zwischen den Zellen, zeichnet
// aber keine Linien — sonst bekämen leere Zellen und die Spacer-Spalte ein Raster.
var table tbl = table.new(position.top_right, 2, 1, border_width = 1, border_color = color.new(color.gray, 100))

// Markiert das aktuelle Chart-Symbol — aber nur, wenn der Chart-Broker
// dem in den Settings ausgewählten Broker entspricht. Padding mit 2 Zeichen
// hält die Symbole in Monospace-Schrift bündig.
chartSym    = syminfo.ticker
brokerMatch = syminfo.prefix == broker

f_mark(string s) =>
    isPair    = s != "" and s != "—"
    isCurrent = brokerMatch and s == chartSym
    isPair ? (isCurrent ? "▶ " + s : "  " + s) : s

if barstate.islast
    gsz = array.size(gegenList)
    tsz = array.size(trendList)
    dataRows = math.max(math.max(gsz, tsz), 1)
    rows = dataRows + 1
    cols = tblOffset > 0 ? 3 : 2   // Spalte 2 = unsichtbarer Spacer, schiebt die Tabelle nach links

    table.delete(tbl)
    tbl := table.new(position.top_right, cols, rows, border_width = 1, border_color = color.new(color.gray, 100))

    table.cell(tbl, 0, 0, "GEGENTREND (" + str.tostring(gsz) + ")", text_color = color.white, bgcolor = color.new(#7b1fa2, 0))
    table.cell(tbl, 1, 0, "TREND (" + str.tostring(tsz) + ")",      text_color = color.white, bgcolor = color.new(#1565c0, 0))
    if tblOffset > 0
        table.cell(tbl, 2, 0, "", width = tblOffset)

    for r = 1 to dataRows
        gi   = r - 1
        gtxt = gi < gsz ? array.get(gegenList, gi) : (gi == 0 and gsz == 0 ? "—" : "")
        ttxt = gi < tsz ? array.get(trendList, gi) : (gi == 0 and tsz == 0 ? "—" : "")
        table.cell(tbl, 0, r, f_mark(gtxt), text_color = color.white, bgcolor = (gtxt == "" or gtxt == "—") ? na : color.new(#7b1fa2, 75), text_font_family = font.family_monospace)
        table.cell(tbl, 1, r, f_mark(ttxt), text_color = color.white, bgcolor = (ttxt == "" or ttxt == "—") ? na : color.new(#1565c0, 75), text_font_family = font.family_monospace)
        if tblOffset > 0
            table.cell(tbl, 2, r, "")
